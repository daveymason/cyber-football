{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cyber Football Coach",
  "version": "0.1.0",
  "identifier": "com.cyberfootball.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: asset: https://asset.localhost; media-src 'self' asset: https://asset.localhost blob: data:"
    },
    "windows": [
      {
        "fullscreen": true,
        "height": 800,
        "width": 1200,
        "title": "Cyber Football Coach"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      }
    }
  }
}
